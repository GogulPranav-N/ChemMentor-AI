# ─────────────────────────────────────────────────────────────────────────────
# Chemistry AI Tutor — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key — obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (gemini-1.5-flash is recommended; gemini-1.5-pro for higher quality)
GEMINI_MODEL=gemini-flash-latest

# Maximum output tokens for Gemini responses
GEMINI_MAX_TOKENS=1024

# ─── RAG Configuration ────────────────────────────────────────────────────────

# Embedding model (HuggingFace MTEB top performer for retrieval)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Text splitter settings
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Number of top chunks to retrieve
TOP_K=5

# ─── Storage ──────────────────────────────────────────────────────────────────

UPLOAD_DIR=uploads
VECTOR_DB_DIR=vector_db

# ─── Application ──────────────────────────────────────────────────────────────

APP_NAME=Chemistry AI Tutor
APP_VERSION=1.0.0
LOG_LEVEL=INFO
